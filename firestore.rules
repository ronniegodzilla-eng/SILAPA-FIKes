rules_version = '2';

// SILAPA-FIKes Security Rules (PRD §4.6, §8).
// Enforcement summary:
//  - Role read from users/{uid}.
//  - Dosen may read/write ONLY laporan of their own bimbingan.
//  - A locked periode ("dikunci") makes its laporan immutable.
//  - IPK is validated 0.00–4.00 at the rules layer (defence-in-depth vs 46268.0).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Satu akun bisa memiliki lebih dari satu peran (mis. Wadek I yang juga
    // Dosen PA) — roles disimpan sebagai array, bukan satu string.
    function userRoles() {
      return isSignedIn() ? userDoc().roles : [];
    }
    function isAdmin()  { return isSignedIn() && 'admin' in userRoles(); }
    function isWadek()  { return isSignedIn() && 'wadek1' in userRoles(); }
    function isDosen()  { return isSignedIn() && 'dosen_pa' in userRoles(); }

    function periodeLocked(periodeId) {
      return get(/databases/$(database)/documents/periode/$(periodeId)).data.status == 'dikunci';
    }

    // Laporan yang SUDAH ditandatangani dosen (dikirim) atau disahkan Wakil
    // Dekan I (diverifikasi) tidak boleh berubah lagi — tanda tangan di atas
    // data yang masih bisa disunting tidak ada artinya. Terbuka kembali bila
    // Wakil Dekan I mengembalikannya, yang sekaligus mencabut tanda tangan.
    function laporanDitandatangani(periodeId, dosenUid) {
      let sub = /databases/$(database)/documents/submissions/$(periodeId + '_' + dosenUid);
      return exists(sub) && get(sub).data.status in ['dikirim', 'diverifikasi'];
    }

    // IPK must be null or within 0.00–4.00.
    function ipValid(ak) {
      return ak.ipKhs == null || (ak.ipKhs is number && ak.ipKhs >= 0 && ak.ipKhs <= 4);
    }

    // Pengunduran diri: dari klien HANYA boleh berstatus 'diajukan'. Keputusan
    // ('disetujui'/'ditolak') milik Wakil Dekan I dan ditulis lewat
    // /api/pengunduran/validasi memakai Admin SDK, yang melewati rules ini.
    // Tanpa penjaga ini seorang dosen PA bisa meloloskan pengajuannya sendiri
    // — dan mengeluarkan mahasiswa dari daftar bimbingannya tanpa persetujuan.
    // Cabang terakhir mengizinkan penyuntingan biasa pada laporan yang berkasnya
    // sudah divalidasi, selama berkas itu sendiri tidak ikut diubah.
    function pengunduranSah() {
      return !('pengunduran' in request.resource.data)
        || request.resource.data.pengunduran == null
        || request.resource.data.pengunduran.status == 'diajukan'
        || request.resource.data.pengunduran == resource.data.pengunduran;
    }

    // ── users ──
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin() || isWadek());
      allow write: if isAdmin();
    }

    // ── periode ──
    match /periode/{periodeId} {
      allow read: if isSignedIn();
      // Admin controls buka/tutup; Wadek locks after verification.
      allow write: if isAdmin() || isWadek();
    }

    // ── mahasiswa master ──
    match /mahasiswa/{npm} {
      allow read: if isSignedIn();
      allow delete: if isAdmin();
      // Admin creates via import/plotting. Dosen may ALSO create a
      // brand-new advisee self-assigned to themselves ("Tambah Mahasiswa"
      // di /dosen/bimbingan) — locked to dosenPaUid == diri sendiri dan
      // hanya field identitas sekali-seumur-kuliah yang dikenal (bukan
      // create bebas field apa pun).
      allow create: if isAdmin()
        || (isDosen()
            && request.resource.data.dosenPaUid == request.auth.uid
            && request.resource.data.keys().hasOnly(
                 ['npm', 'nama', 'prodi', 'angkatan', 'kelas', 'dosenPaUid',
                  'pkkmb', 'toefl', 'esq', 'semkes', 'ipHistory',
                  'pkkmbBukti', 'toeflBukti', 'esqBukti']));
      // Dosen may update only the once-per-degree master fields
      // (pkkmb/toefl/esq/semkes) + ipHistory for their bimbingan.
      // `kelas` ikut boleh: distribusi SIAKAD tidak memuatnya sehingga hampir
      // semua record masih '-', dan hanya dosen PA/mahasiswanya yang tahu
      // kelas sebenarnya. Identitas lain (npm/nama/prodi/angkatan/dosenPaUid)
      // tetap tertutup.
      // `statusGlobal` ikut boleh, TAPI hanya bernilai salah satu status yang
      // memang bisa dipilih dosen di form. Ini yang membuat "lulus" berlaku
      // seterusnya: penyaring pembukaan periode membaca field ini, sehingga
      // mahasiswa yang sudah diwisuda tidak muncul lagi periode berikutnya.
      // 'keluar' sengaja TIDAK diizinkan — mengeluarkan mahasiswa dari sistem
      // tetap wewenang admin, bukan efek samping penyetelan status oleh dosen.
      allow update: if isAdmin()
        || (isDosen()
            && resource.data.dosenPaUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['pkkmb', 'toefl', 'esq', 'semkes', 'ipHistory', 'updatedAt',
                           'kelas', 'pkkmbBukti', 'toeflBukti', 'esqBukti', 'statusGlobal'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['statusGlobal'])
                || request.resource.data.statusGlobal in ['aktif', 'cuti', 'non_aktif', 'lulus']));
    }

    // ── laporan (one per mahasiswa per periode) ──
    match /laporan/{id} {
      allow read: if isAdmin() || isWadek()
        || (isDosen() && resource.data.dosenPaUid == request.auth.uid);

      // Records are normally generated by admin when the periode opens.
      // Dosen may ALSO create one laporan doc, tied to the SAME new
      // mahasiswa doc they just created in the same batch (dosenPaUid ==
      // diri sendiri, periode belum terkunci, shape terbatas).
      allow create: if isAdmin()
        || (isDosen()
            && request.resource.data.dosenPaUid == request.auth.uid
            && !periodeLocked(request.resource.data.periodeId)
            && ipValid(request.resource.data.akademik)
            && request.resource.data.keys().hasOnly(
                 ['npm', 'prodi', 'dosenPaUid', 'semesterKe', 'semesterKeManual',
                  'kelas', 'status', 'akademik', 'nonAkademik', 'skripsi',
                  'permasalahan', 'rekomendasi', 'rekomendasiDO', 'dikunciMandiri',
                  'pengunduran', 'statusPengisian', 'periodeId']));
      allow delete: if isAdmin();

      // Dosen edits only their own, only while the periode is unlocked,
      // and IPK stays in range. Admin pun tidak boleh memvalidasi pengunduran
      // diri — itu wewenang Wakil Dekan I lewat route server.
      //
      // Berlaku bagi admin juga: begitu laporan ditandatangani dan dikirim,
      // koreksi harus lewat Wakil Dekan I yang mengembalikannya. Route server
      // (Admin SDK) melewati aturan ini, jadi pengembalian tetap bisa membuka
      // kuncinya.
      allow update: if !periodeLocked(resource.data.periodeId)
        && !laporanDitandatangani(resource.data.periodeId, resource.data.dosenPaUid)
        && pengunduranSah()
        && (isAdmin()
            || (isDosen()
                && resource.data.dosenPaUid == request.auth.uid
                && ipValid(request.resource.data.akademik)));
    }

    // ── submissions (per dosen per periode) ──
    match /submissions/{id} {
      allow read: if isAdmin() || isWadek()
        || (isDosen() && resource.data.dosenUid == request.auth.uid);
      allow create: if isAdmin();
      // Pengiriman dan validasi laporan TIDAK lagi ditulis dari klien: keduanya
      // membubuhkan tanda tangan elektronik dan harus lewat
      // /api/laporan/status (Admin SDK, jam server). Karena itu klien tidak
      // boleh menyentuh field tanda tangan sama sekali, dan hanya admin yang
      // masih boleh mengubah `status` sebagai jalan darurat. Dosen/wadek tetap
      // boleh menulis field lain (mis. jumlah bimbingan saat plotting).
      allow update: if !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['ttdDosen', 'ttdWadek'])
        && (isAdmin()
            || (request.resource.data.status == resource.data.status
                && (isWadek()
                    || (isDosen() && resource.data.dosenUid == request.auth.uid
                        && !periodeLocked(resource.data.periodeId)))));
    }

    // ── rekapCache (PRD §8): agregat fakultas dihitung ulang oleh app ──
    // Bukan Cloud Function (paket gratis) — admin/wadek1 boleh menulis saat
    // memicu recompute (import, buka periode, verifikasi); dosen tidak
    // butuh rekap lintas fakultas, jadi read juga dibatasi admin/wadek1.
    match /rekapCache/{periodeId} {
      allow read, write: if isAdmin() || isWadek();
    }

    // ── tokenIsiData (§ isi-data mandiri mahasiswa tanpa akun) ──
    // Satu token per dosen, dibagikan sebagai link publik (WhatsApp) yang
    // mahasiswa bimbingannya buka TANPA login. Karena tidak ada akun/uid di
    // sisi mahasiswa untuk diverifikasi rules, validasi token + pemetaan
    // npm→dosen dilakukan SELURUHNYA di server (Admin SDK, lihat
    // /api/public/isi-data) yang otomatis melewati rules ini. Deny-all di
    // sini murni defence-in-depth agar koleksi ini tidak pernah bisa
    // dibaca/ditulis langsung dari client SDK oleh siapa pun.
    match /tokenIsiData/{token} {
      allow read, write: if false;
    }
  }
}
