# ─────────────────────────────────────────────────────────────
# Firebase Web (client) config — from Firebase Console →
# Project settings → General → Your apps → Web app → SDK setup.
# These are safe to expose to the browser (NEXT_PUBLIC_*).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Firebase Admin (server / seed script only) — NEVER commit.
# Download from Firebase Console → Project settings →
# Service accounts → Generate new private key.
# Point this at the downloaded JSON file:
# ─────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ─────────────────────────────────────────────────────────────
# Upload bukti (opsional, prestasi/beasiswa/TOEFL/PKKMB/ESQ/organisasi) —
# backend Google Apps Script + Google Drive. TIDAK boleh pakai prefix
# NEXT_PUBLIC_ (server-only). Cara dapatkan nilainya: apps-script/README.md.
# ─────────────────────────────────────────────────────────────
APPS_SCRIPT_UPLOAD_URL=
APPS_SCRIPT_UPLOAD_SECRET=
