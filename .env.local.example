# ─────────────────────────────────────────────────────────────
# Firebase Web (client) config — from Firebase Console →
# Project settings → General → Your apps → Web app → SDK setup.
# These are safe to expose to the browser (NEXT_PUBLIC_*).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Firebase Admin (server) — NEVER commit. Download dari Firebase Console →
# Project settings → Service accounts → Generate new private key.
#
# Untuk dev lokal (dan scripts/*.ts): simpan file JSON-nya sebagai
# ./serviceAccountKey.json (sudah di-gitignore) dan pakai baris di bawah ini.
# ─────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Untuk Vercel (tidak ada filesystem persisten untuk file di atas): buka
# serviceAccountKey.json di editor teks, salin SELURUH isinya (satu baris
# JSON utuh), lalu tempel sebagai value env var ini di Vercel Project
# Settings → Environment Variables. src/lib/firebase-admin.ts otomatis
# memakai ini duluan kalau ada, sebelum mencoba file lokal di atas.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─────────────────────────────────────────────────────────────
# Upload bukti (opsional, prestasi/beasiswa/TOEFL/PKKMB/ESQ/organisasi) —
# backend Google Apps Script + Google Drive. TIDAK boleh pakai prefix
# NEXT_PUBLIC_ (server-only). Cara dapatkan nilainya: apps-script/README.md.
# ─────────────────────────────────────────────────────────────
APPS_SCRIPT_UPLOAD_URL=
APPS_SCRIPT_UPLOAD_SECRET=
